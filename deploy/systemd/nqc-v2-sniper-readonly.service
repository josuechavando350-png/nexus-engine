# NQC V2 sniper: deployable service, NOT enabled by committing this file.
# READ-ONLY RPC, no Ethereum signing, no self-funded gas.
# Continuous read-only activation authorized on 2026-10-13; access still required.
[Unit]
Description=NQC V2 Read-only Aave Sniper Research Observer (NO TRADE)
Documentation=https://github.com/josuechavando350-png/nexus-engine/pull/692
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=/opt/nqc/sniper-readonly/current/sniper_continuous_service.py

[Service]
Type=simple
User=nqc-sniper
Group=nqc-sniper
StateDirectory=nqc-sniper-readonly
WorkingDirectory=/opt/nqc/sniper-readonly/current
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/opt/nqc/sniper-readonly/current/source.env
ExecStart=/usr/bin/python3 /opt/nqc/sniper-readonly/current/sniper_continuous_service.py --out-dir /var/lib/nqc-sniper-readonly --interval-seconds 60 --max-cycles 0
Restart=on-failure
RestartSec=90
TimeoutStopSec=15

# The journal is the ONLY requested writable path. No wallet credentials.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
