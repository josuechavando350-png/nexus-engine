{
  "name": "nexus-web-engine",
  "private": true,
  "version": "6.0.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --exclude packages/capture/tests/apca-audit.test.ts --exclude packages/capture/tests/playwright-adapter.test.ts --exclude packages/capture/tests/mutation-runner.test.ts",
    "test:browser": "vitest run packages/capture/tests/apca-audit.test.ts packages/capture/tests/playwright-adapter.test.ts packages/capture/tests/mutation-runner.test.ts",
    "test:watch": "vitest",
    "build": "node scripts/build-workspace.mjs && node scripts/assert-clean-build.mjs",
    "build:deterministic": "node scripts/verify-deterministic-build.mjs",
    "quality-gates": "node scripts/quality-gates.mjs",
    "security-hygiene": "node scripts/security-hygiene.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "client:run": "node scripts/nexus-client-pipeline.mjs",
    "v3-gates": "node scripts/run-v3-gates.mjs",
    "rust:test": "cargo test --locked --workspace --manifest-path runtime/Cargo.toml",
    "rust:lint": "cargo clippy --locked --all-targets --manifest-path runtime/Cargo.toml -- -D warnings",
    "rust:build": "cargo build --locked --workspace --release --manifest-path runtime/Cargo.toml",
    "demo:e2e": "cargo run --locked -p factory-line --manifest-path runtime/Cargo.toml",
    "v4-gates": "node scripts/v4-architecture-gates.mjs",
    "demo:v4": "cargo run --locked -p autonomous-factory --manifest-path runtime/Cargo.toml",
    "v5-gates": "node scripts/v5-architecture-gates.mjs",
    "v6-gates": "node scripts/v6-architecture-gates.mjs",
    "demo:v6": "cargo run --locked -p distributed-factory --manifest-path runtime/Cargo.toml",
    "v7-gates": "node scripts/v7-architecture-gates.mjs",
    "v8-gates": "node scripts/v8-architecture-gates.mjs",
    "v9-gates": "node scripts/v9-architecture-gates.mjs",
    "v10-gates": "node scripts/v10-architecture-gates.mjs && node scripts/v10-final-readiness-gates.mjs",
    "v10-full-validation": "pnpm test && pnpm build && pnpm test:browser && pnpm operability:h07 && pnpm v10-gates",
    "operability:h07": "node scripts/h07-operability-proof.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "globals": "^16.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    }
  }
}
