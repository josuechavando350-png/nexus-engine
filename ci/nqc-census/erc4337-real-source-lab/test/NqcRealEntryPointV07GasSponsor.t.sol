pragma solidity ^0.8.23;

// One local EVM source-authentic EIP-4337 0.7.0 execution test.
// EntryPoint, BasePaymaster, IAccount and PackedUserOperation are checkout
// of eth-infinitism/account-abstraction@7af70c8993a6f42973f520ae0752386a5032abe7.
// Local native value is generated by Foundry vm.deal, NOT a real gas sponsor.
// This isolated suite tests real ERC-4337 accounting against a MOCK target,
// NOT integration with authentic Morpho.sol nor deployed Robinhood contracts.
import {EntryPoint} from "../lib/account-abstraction/contracts/core/EntryPoint.sol";
import {BasePaymaster} from "../lib/account-abstraction/contracts/core/BasePaymaster.sol";
import {IAccount} from "../lib/account-abstraction/contracts/interfaces/IAccount.sol";
import {IEntryPoint} from "../lib/account-abstraction/contracts/interfaces/IEntryPoint.sol";
import {PackedUserOperation} from "../lib/account-abstraction/contracts/interfaces/PackedUserOperation.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {MessageHashUtils} from "@openzeppelin/contracts/utils/cryptography/MessageHashUtils.sol";

interface Vm4337Nqc {
    function deal(address who, uint256 newBalance) external;
    function sign(uint256 privateKey, bytes32 digest) external returns (uint8 v, bytes32 r, bytes32 s);
    function addr(uint256 privateKey) external returns (address);
    function txGasPrice(uint256 price) external;
    function fee(uint256 basefee) external;
}

contract Nqc4337MockOnlyLiquidationTarget {
    uint256 public executed;
    bool public shouldRevert;
    function toggleRevert(bool value) external { shouldRevert = value; }
    function executePretendLiquidation() external {
        if (shouldRevert) revert("MOCK_LIQUIDATION_REVERT");
        executed += 1;
    }
}

contract Nqc4337EIP712SignedAccountTestOnly is IAccount {
    using MessageHashUtils for bytes32;
    address public immutable entryPoint;
    address public immutable owner;

    constructor(address ep, address accountOwner) {
        require(ep != address(0) && accountOwner != address(0));
        entryPoint = ep;
        owner = accountOwner;
    }

    function validateUserOp(
        PackedUserOperation calldata userOp,
        bytes32 userOpHash,
        uint256 missingAccountFunds
    ) external override returns (uint256 validationData) {
        require(msg.sender == entryPoint, "ONLY_AUTHENTIC_ENTRYPOINT");
        require(missingAccountFunds == 0, "ACCOUNT_REQUIRES_SPONSOR");
        bytes32 digest = userOpHash.toEthSignedMessageHash();
        // Real secp256k1 ECDSA, but test-owned key only. Actual signer security
        // and approved account policy are NOT independently audited here.
        if (userOp.signature.length != 65) return 1;
        address recovered = ECDSA.recover(digest, userOp.signature);
        if (recovered != owner) return 1;
        return 0;
    }

    function execute(address target, bytes calldata callData) external {
        require(msg.sender == entryPoint, "ACCOUNT_EXEC_RESTRICTED");
        (bool ok, bytes memory returnData) = target.call(callData);
        if (!ok) {
            assembly ("memory-safe") {
                revert(add(returnData, 32), mload(returnData))
            }
        }
    }
}

// Research-only sponsor policy, funds deposited into authentic EIP-4337 v0.7.
// Not a full production paymaster: no staking policy, fraud management,
// profitability gates, gas-to-USDG conversion, or external underwriting.
contract Nqc4337RealSourcePaymasterTestOnly is BasePaymaster {
    address public immutable permittedSender;
    uint256 public immutable maxCostWei;
    constructor(IEntryPoint ep, address sender, uint256 cap)
        BasePaymaster(ep)
    {
        permittedSender = sender;
        maxCostWei = cap;
    }

    function _validatePaymasterUserOp(
        PackedUserOperation calldata userOp,
        bytes32, uint256 maxCost
    ) internal view override returns (bytes memory context, uint256 validationData) {
        require(userOp.sender == permittedSender && maxCost <= maxCostWei, "SPONSOR_POLICY");
        return ("", 0); // no postOp; EntryPoint deducts actual gas
    }
}

contract NqcRealEntryPointV07GasSponsorTest {
    Vm4337Nqc private constant vm = Vm4337Nqc(address(uint160(
        uint256(keccak256("hevm cheat code"))
    )));
    uint256 private constant OWNER_KEY = 0x1234;
    uint256 private constant WRONG_KEY = 0x5678;
    address payable private constant BENEFICIARY = payable(address(0xBEEF));

    EntryPoint private entryPoint;
    Nqc4337EIP712SignedAccountTestOnly private account;
    Nqc4337MockOnlyLiquidationTarget private target;
    Nqc4337RealSourcePaymasterTestOnly private paymaster;

    function setUp() public {
        vm.deal(address(this), 1 ether); // LOCAL fake native test value only
        vm.fee(1 gwei);
        vm.txGasPrice(2 gwei);
        entryPoint = new EntryPoint(); // REAL official source v0.7
        account = new Nqc4337EIP712SignedAccountTestOnly(
            address(entryPoint), vm.addr(OWNER_KEY)
        );
        target = new Nqc4337MockOnlyLiquidationTarget();
        paymaster = new Nqc4337RealSourcePaymasterTestOnly(
            IEntryPoint(address(entryPoint)), address(account), 1e16
        );
        paymaster.deposit{value: 1e17}();
        require(entryPoint.balanceOf(address(paymaster)) == 1e17,
            "REAL_ENTRYPOINT_DEPOSIT_MISSING");
        require(address(account).balance == 0,
            "ACCOUNT_SHOULD_NOT_HOLD_NATIVE_GAS");
    }

    function _op(address sponsorAddress, uint256 signerKey)
        internal returns (PackedUserOperation memory op)
    {
        op.sender = address(account);
        op.nonce = entryPoint.getNonce(address(account), 0);
        op.initCode = "";
        op.callData = abi.encodeCall(
            Nqc4337EIP712SignedAccountTestOnly.execute,
            (address(target), abi.encodeWithSelector(
                Nqc4337MockOnlyLiquidationTarget.executePretendLiquidation.selector
            ))
        );
        op.accountGasLimits = bytes32((uint256(500_000) << 128) | uint256(800_000));
        op.preVerificationGas = 120_000;
        op.gasFees = bytes32((uint256(1 gwei) << 128) | uint256(3 gwei));
        op.paymasterAndData = abi.encodePacked(
            sponsorAddress, bytes16(uint128(220_000)), bytes16(uint128(160_000))
        );
        bytes32 userOpHash = entryPoint.getUserOpHash(op);
        bytes32 digest = MessageHashUtils.toEthSignedMessageHash(userOpHash);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(signerKey, digest);
        op.signature = abi.encodePacked(r, s, v);
    }

    function _submit(PackedUserOperation memory op) internal {
        PackedUserOperation[] memory operations = new PackedUserOperation[](1);
        operations[0] = op;
        entryPoint.handleOps(operations, BENEFICIARY);
    }

    function testRealEntryPointV07SuccessfullyDebitsSponsorNotAccount() public {
        uint256 sponsorBefore = entryPoint.balanceOf(address(paymaster));
        uint256 beneficiaryBefore = BENEFICIARY.balance;
        uint256 senderDepositBefore = entryPoint.balanceOf(address(account));
        _submit(_op(address(paymaster), OWNER_KEY));
        require(target.executed() == 1, "AUTHENTIC_ENTRYPOINT_DID_NOT_EXECUTE");
        require(entryPoint.balanceOf(address(paymaster)) < sponsorBefore,
            "SPONSOR_DEPOSIT_NOT_CHARGED");
        require(BENEFICIARY.balance > beneficiaryBefore, "BUNDLER_NOT_COMPENSATED");
        require(address(account).balance == 0, "SMART_ACCOUNT_USED_NATIVE");
        require(entryPoint.balanceOf(address(account)) == senderDepositBefore,
            "ACCOUNT_ENTRYPOINT_DEPOSIT_WAS_BILLED");
        require(entryPoint.getNonce(address(account), 0) == 1,
            "REAL_ENTRYPOINT_NONCE_DID_NOT_ADVANCE");
    }

    function testRealEntryPointV07ChargesSponsorForRevertedExecution() public {
        target.toggleRevert(true);
        uint256 sponsorBefore = entryPoint.balanceOf(address(paymaster));
        uint256 beneficiaryBefore = BENEFICIARY.balance;
        _submit(_op(address(paymaster), OWNER_KEY));
        require(target.executed() == 0, "FAILED_EXECUTION_MUTATED_TARGET");
        require(entryPoint.balanceOf(address(paymaster)) < sponsorBefore,
            "FAILED_OPERATION_MUST_COST_SPONSOR_GAS");
        require(BENEFICIARY.balance > beneficiaryBefore,
            "FAILED_OPERATION_DID_NOT_PAY_BUNDLER");
        require(address(account).balance == 0, "ACCOUNT_FUNDING_USED");
        require(entryPoint.getNonce(address(account), 0) == 1,
            "FAILED_EXECUTION_NONCE_SHOULD_ADVANCE");
    }

    function testRealEntryPointV07CannotUseSponsorWithNoDeposit() public {
        Nqc4337RealSourcePaymasterTestOnly unfunded =
            new Nqc4337RealSourcePaymasterTestOnly(
                IEntryPoint(address(entryPoint)), address(account), 1e16
            );
        PackedUserOperation memory op = _op(address(unfunded), OWNER_KEY);
        try this.externalSubmit(op) {
            revert("UNFUNDED_SPONSOR_WAS_ACCEPTED");
        } catch {
            require(target.executed() == 0, "UNFUNDED_EXECUTED_CALL");
            require(entryPoint.getNonce(address(account), 0) == 0,
                "UNFUNDED_SHOULD_NOT_CONSUME_NONCE");
        }
    }

    function testRealEntryPointV07RejectsWrongAccountSignature() public {
        PackedUserOperation memory op = _op(address(paymaster), WRONG_KEY);
        uint256 beforePaymaster = entryPoint.balanceOf(address(paymaster));
        try this.externalSubmit(op) {
            revert("INVALID_SIGNATURE_ACCEPTED");
        } catch {
            require(target.executed() == 0, "INVALID_SIGNATURE_MUTATED_TARGET");
            require(entryPoint.balanceOf(address(paymaster)) == beforePaymaster,
                "INVALID_OP_SPONSOR_DEBITED");
        }
    }

    function testSmartAccountCannotBeDirectlyInvokedByStranger() public {
        (bool ok,) = address(account).call(abi.encodeCall(
            Nqc4337EIP712SignedAccountTestOnly.execute,
            (address(target), abi.encodeWithSelector(
                Nqc4337MockOnlyLiquidationTarget.executePretendLiquidation.selector
            ))
        ));
        require(!ok && target.executed() == 0, "DIRECT_ACCOUNT_EXECUTION_ALLOWED");
    }

    // Helper external call creates a catchable top-level call boundary in local Foundry.
    function externalSubmit(PackedUserOperation calldata op) external {
        require(msg.sender == address(this), "ONLY_TEST_HARNESS");
        PackedUserOperation[] memory ops = new PackedUserOperation[](1);
        ops[0] = op;
        entryPoint.handleOps(ops, BENEFICIARY);
    }
}
