{
  "$id": "https://nexus.local/nqc/protocol-fork/corpus/fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account": {
      "additionalProperties": false,
      "properties": {
        "observed_liquidations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "borrower": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "collateral_asset": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "debt_asset": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "debt_to_cover": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "liquidated_collateral_amount": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "liquidator": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "log_index": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]+$"
              },
              "receive_atoken": {
                "type": "boolean"
              }
            },
            "required": [
              "borrower",
              "collateral_asset",
              "debt_asset",
              "debt_to_cover",
              "liquidated_collateral_amount",
              "liquidator",
              "log_index",
              "receive_atoken"
            ]
          }
        },
        "total_liquidation_log_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "observed_liquidations",
        "total_liquidation_log_count"
      ],
      "type": "object"
    },
    "block_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "block_number": {
      "minimum": 1,
      "type": "integer"
    },
    "case_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$",
      "type": "string"
    },
    "chain_id": {
      "minimum": 1,
      "type": "integer"
    },
    "class_tags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "expected": {
      "type": "object"
    },
    "parent_hash": {
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "protocol": {
      "minProperties": 1,
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "historical_state_served": {
          "type": "boolean"
        },
        "identity": {
          "minLength": 1,
          "type": "string"
        },
        "identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "owned_reth",
            "archive_rpc",
            "fork_snapshot"
          ]
        }
      },
      "required": [
        "kind",
        "identity",
        "identity_sha256",
        "historical_state_served"
      ],
      "type": "object"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "failure_artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_TESTED"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "strategy_family": {
      "enum": [
        "liquidation",
        "backrun"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "strategy_family",
    "class_tags",
    "chain_id",
    "block_number",
    "block_hash",
    "parent_hash",
    "source_commit",
    "provider",
    "protocol",
    "result"
  ],
  "title": "NQC T39 immutable historical fork fixture",
  "type": "object"
}
