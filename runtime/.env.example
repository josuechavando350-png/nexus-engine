# NEXUS V3 Industrial Agentic Runtime — example configuration.
#
# Copy to .env and fill in per environment. NOTHING in this file is a real
# credential and no default in the code is a credential: a service that needs
# a secret and cannot find one fails to start rather than using a well-known
# value. `.env` is gitignored; only this example is committed.

# ---------------------------------------------------------------------------
# Logging and identity
# ---------------------------------------------------------------------------
NEXUS_LOG_LEVEL=info
NEXUS_SITE_ID=plant-01
NEXUS_ZONE_ID=zone-press-hall

# ---------------------------------------------------------------------------
# Data highway (Kafka / Redpanda). Only read with --features kafka.
# ---------------------------------------------------------------------------
NEXUS_BROKERS=localhost:19092
NEXUS_CONSUMER_GROUP=nexus-ingest
NEXUS_TOPIC_TELEMETRY_RAW=nexus.telemetry.raw
NEXUS_TOPIC_TELEMETRY_NORMALIZED=nexus.telemetry.normalized
NEXUS_TOPIC_DETECTIONS=nexus.detections
NEXUS_TOPIC_GRAPH_MUTATIONS=nexus.graph.mutations
NEXUS_TOPIC_TASK_PROPOSALS=nexus.task.proposals
NEXUS_TOPIC_AUDIT=nexus.audit
NEXUS_TOPIC_DEADLETTER=nexus.deadletter

# Backpressure and retry
NEXUS_MAX_INFLIGHT=1024
NEXUS_QUEUE_CAPACITY=8192
NEXUS_MAX_RETRIES=5
NEXUS_RETRY_BASE_MS=50
NEXUS_RETRY_MAX_MS=30000
NEXUS_DEDUP_WINDOW=100000

# SASL/TLS for the broker. Leave blank for a local plaintext dev broker.
NEXUS_BROKER_SECURITY_PROTOCOL=
NEXUS_BROKER_SASL_MECHANISM=
NEXUS_BROKER_SASL_USERNAME=
NEXUS_BROKER_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Ontology backend. Unset or "memory" selects the non-durable in-memory store.
# Selecting neo4j requires building with --features neo4j.
# ---------------------------------------------------------------------------
NEXUS_GRAPH_BACKEND=memory
NEXUS_GRAPH_URI=bolt://localhost:7687
NEXUS_GRAPH_USER=neo4j
NEXUS_GRAPH_PASSWORD=
NEXUS_GRAPH_DATABASE=neo4j
NEXUS_GRAPH_MAX_CONNECTIONS=16
NEXUS_GRAPH_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Edge execution
#
# SIMULATION           — no physical actuation. The only mode used in CI.
# PHYSICAL_NON_WEAPONIZED — real actuation, non-weaponized devices only.
#                        Requires real signing keys; DevSigner is refused.
# ---------------------------------------------------------------------------
NEXUS_EXECUTION_MODE=SIMULATION
NEXUS_EDGE_FUEL_BUDGET=5000000
NEXUS_EDGE_MEMORY_LIMIT_BYTES=16777216
NEXUS_EDGE_TIMEOUT_MS=2000
NEXUS_EDGE_MODULE_DIR=./modules

# Signing. Ed25519 keys are supplied by the deployment's secret manager and
# are never written to this repository or to a container image.
NEXUS_SIGNER_ID=
NEXUS_SIGNING_KEY_PATH=
NEXUS_TRUSTED_SIGNERS_PATH=

# ---------------------------------------------------------------------------
# One-way gateway
#
# OBSERVATION_DIODE — egress only, no listener, no command path.
# CONTROLLED_EDGE   — separate identity and channel for legitimate control.
# ---------------------------------------------------------------------------
NEXUS_GATEWAY_PROFILE=OBSERVATION_DIODE
NEXUS_GATEWAY_CLASSIFICATION_CEILING=internal
NEXUS_GATEWAY_SPOOL_PATH=/var/lib/nexus/spool
NEXUS_GATEWAY_SPOOL_MAX_BYTES=536870912
